      "rung": "fault_test",
      "owner": "lib/account_context.dart",
      "artifacts": ["test/account_switch_storm_test.dart"]
    },
    "versioned-compatibility": {
      "rung": "ci_check",
      "owner": "compatibility_manifest.json",
      "artifacts": ["test/mixed_version_compatibility_test.dart"]
    },
    "typed-exact-evidence": {
      "rung": "ci_check",
      "owner": "docs/acceptance_contracts.json",
      "artifacts": ["scripts/acceptance_contracts.dart"]
