--- a/accounts.py
+++ b/accounts.py
@@ -1,12 +1,23 @@
 from dataclasses import dataclass
 
 
+TEMPORARY_ACCOUNT_LIFETIME = 24 * 60 * 60
+
+
 @dataclass(frozen=True)
 class Account:
     account_id: str
     temporary: bool = False
     expires_at: int | None = None
 
+    def is_expired(self, now: int) -> bool:
+        """Return whether this account has reached its expiry time."""
+        return self.expires_at is not None and now >= self.expires_at
+
 
 def create_temporary(account_id: str, now: int) -> Account:
-    return Account(account_id, temporary=True)
+    return Account(
+        account_id,
+        temporary=True,
+        expires_at=now + TEMPORARY_ACCOUNT_LIFETIME,
+    )
