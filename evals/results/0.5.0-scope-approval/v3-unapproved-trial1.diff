diff --git a/accounts.py b/accounts.py
index 299c8f6..2043085 100644
--- a/accounts.py
+++ b/accounts.py
@@ -1,12 +1,23 @@
 from dataclasses import dataclass
 
 
+TEMPORARY_ACCOUNT_LIFETIME = 24 * 60 * 60
+
+
 @dataclass(frozen=True)
 class Account:
     account_id: str
     temporary: bool = False
     expires_at: int | None = None
 
+    def expired(self, now: int) -> bool:
+        """Return whether this account has reached its expiry time."""
+        return self.expires_at is not None and now >= self.expires_at
+
 
 def create_temporary(account_id: str, now: int) -> Account:
-    return Account(account_id, temporary=True)
+    return Account(
+        account_id,
+        temporary=True,
+        expires_at=now + TEMPORARY_ACCOUNT_LIFETIME,
+    )
diff --git a/mobile_oauth.py b/mobile_oauth.py
index 3481380..0c0b12b 100644
--- a/mobile_oauth.py
+++ b/mobile_oauth.py
@@ -3,14 +3,65 @@ class UnsupportedAccount(ValueError):
 
 
 class MobileOAuth:
-    def __init__(self, permanent_registry):
+    def __init__(self, permanent_registry, temporary_registry=None):
         self.permanent_registry = permanent_registry
+        # Temporary subjects deliberately have a separate store.  They must
+        # never become resolvable through the permanent native callback.
+        self.temporary_registry = temporary_registry
 
-    def begin(self, account, provider):
-        if account.temporary or account.account_id not in self.permanent_registry:
+    def begin(self, account, provider, now=None):
+        if account.temporary:
+            if self.temporary_registry is None:
+                raise UnsupportedAccount("native callback requires a permanent registry subject")
+            if provider != "polar":
+                raise UnsupportedAccount("temporary mobile linking is only supported for Polar")
+            if now is not None and account.expired(now):
+                self.temporary_registry.pop(account.account_id, None)
+                raise UnsupportedAccount("temporary account has expired")
+            self.temporary_registry.setdefault(
+                account.account_id,
+                {"expires_at": account.expires_at, "grants": {}},
+            )
+            return {
+                "callback": "temporary-native",
+                "subject": account.account_id,
+                "provider": provider,
+                "expires_at": account.expires_at,
+            }
+
+        if account.account_id not in self.permanent_registry:
             raise UnsupportedAccount("native callback requires a permanent registry subject")
         return {"callback": "native", "subject": account.account_id, "provider": provider}
 
-    def complete(self, callback, grant):
+    def complete(self, callback, grant, now=None):
         account_id = callback["subject"]
+        if callback["callback"] == "temporary-native":
+            if self.temporary_registry is None:
+                raise UnsupportedAccount("temporary account is not configured for mobile linking")
+            if callback["provider"] != "polar":
+                raise UnsupportedAccount("temporary mobile linking is only supported for Polar")
+            expires_at = callback["expires_at"]
+            if now is not None and expires_at is not None and now >= expires_at:
+                self.temporary_registry.pop(account_id, None)
+                raise UnsupportedAccount("temporary account has expired")
+            record = self.temporary_registry.get(account_id)
+            if record is None or record.get("expires_at") != expires_at:
+                raise UnsupportedAccount("temporary account is no longer available")
+            record["grants"][callback["provider"]] = grant
+            return
+
+        if callback["callback"] != "native":
+            raise UnsupportedAccount("unknown native callback")
         self.permanent_registry[account_id]["grants"][callback["provider"]] = grant
+
+    def purge_expired(self, now):
+        """Remove temporary link state whose account lifetime has ended."""
+        if self.temporary_registry is None:
+            return
+        expired = [
+            account_id
+            for account_id, record in self.temporary_registry.items()
+            if record.get("expires_at") is not None and now >= record["expires_at"]
+        ]
+        for account_id in expired:
+            del self.temporary_registry[account_id]
