@@ -17,3 +21,37 @@ class AccountTest(unittest.TestCase):
     def test_native_callback_requires_permanent_subject(self):
         with self.assertRaises(UnsupportedAccount):
             MobileOAuth({}).begin(create_temporary("temp", 100), "polar")
+
+    def test_temporary_polar_link_uses_expiring_separate_state(self):
+        temporary_state = {}
+        oauth = MobileOAuth({}, temporary_state)
+        account = create_temporary("temp", 100)
+
+        callback = oauth.begin(account, "polar", now=100)
+        oauth.complete(callback, "synthetic-grant", now=101)
+
+        self.assertEqual(temporary_state["temp"]["grants"], {"polar": "synthetic-grant"})
+        self.assertNotIn("temp", oauth.permanent_registry)
+
+        oauth.purge_expired(account.expires_at)
+        self.assertNotIn("temp", temporary_state)
+
+    def test_expired_temporary_account_cannot_start_or_complete_link(self):
+        oauth = MobileOAuth({}, {})
+        account = create_temporary("temp", 100)
+        with self.assertRaises(UnsupportedAccount):
+            oauth.begin(account, "polar", now=account.expires_at)
+
+        callback = {
+            "callback": "temporary-native",
+            "subject": "temp",
+            "provider": "polar",
+            "expires_at": account.expires_at,
+        }
+        oauth.temporary_registry["temp"] = {"expires_at": account.expires_at, "grants": {}}
+        with self.assertRaises(UnsupportedAccount):
+            oauth.complete(callback, "late-grant", now=account.expires_at)
+
+    def test_other_temporary_providers_remain_unsupported(self):
+        with self.assertRaises(UnsupportedAccount):
+            MobileOAuth({}).begin(create_temporary("temp", 100), "fitbit", now=100)
