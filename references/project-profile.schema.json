{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidiw/skills/project-profile.schema.json",
  "title": "Engineering Harness Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness_policy_version",
    "status",
    "project",
    "sources",
    "capabilities",
    "enforcement",
    "exceptions"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "harness_policy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {"enum": ["proposed", "accepted"]},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "sensitive_data"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "sensitive_data": {"type": "boolean"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/repository_path"},
      "properties": {
        "agent_rules": {"$ref": "#/$defs/repository_path"},
        "architecture": {"$ref": "#/$defs/repository_path"},
        "work_tracker": {"$ref": "#/$defs/repository_path"},
        "compatibility": {"$ref": "#/$defs/repository_path"},
        "acceptance_contracts": {"$ref": "#/$defs/repository_path"},
        "operator_interface": {"$ref": "#/$defs/repository_path"}
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "boolean"}
    },
    "enforcement": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rung", "owner"],
        "properties": {
          "rung": {
            "enum": ["principle", "owner", "audit", "local_check", "ci_check", "runtime_guard", "fault_test"]
          },
          "owner": {"type": "string", "minLength": 1},
          "artifacts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant", "scope", "rationale", "authority"],
        "properties": {
          "invariant": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "removal_condition": {"type": "string", "minLength": 1}
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner_version", "repository_revision", "project_fields", "capabilities"],
      "properties": {
        "scanner_version": {"const": 3},
        "repository_revision": {
          "type": "string",
          "pattern": "^(unversioned|[0-9a-f]{40})$"
        },
        "project_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sensitive_data"],
          "properties": {
            "sensitive_data": {"$ref": "#/$defs/discovery_finding"}
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/discovery_finding"}
        }
      }
    }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1
    },
    "discovery_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suggested", "confidence", "evidence"],
      "properties": {
        "suggested": {"type": "boolean"},
        "confidence": {"enum": ["none", "low", "medium", "high"]},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "path"],
            "properties": {
              "rule": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
